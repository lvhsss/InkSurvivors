# Address of the deployed Ink Survivors contract (Ethereum mainnet).
# Leave unset to run in mock mode (no wallet required).
NEXT_PUBLIC_CONTRACT_ADDRESS=

# 1 = Ethereum mainnet, 11155111 = Sepolia (testing only).
NEXT_PUBLIC_CHAIN_ID=1

# Block at which the Ink Survivors contract was deployed. Owner-token enumeration
# replays Transfer logs from this height; leave blank to scan from genesis.
NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=

# REQUIRED — WalletConnect Cloud project id. WalletConnect is the only supported
# connector; the app fails loudly at startup if this is missing.
# Get one at https://cloud.walletconnect.com.
NEXT_PUBLIC_WC_PROJECT_ID=

# OPTIONAL — preferred RPC endpoints, tried first by the fallback transport.
# The app already rotates through several keyless public providers
# (PublicNode, Tenderly, dRPC, Cloudflare). Set a paid provider URL
# (Alchemy / QuickNode / Infura) here to put it at the head of the rotation.
# Leave blank to use only the keyless rotation.
NEXT_PUBLIC_RPC_URL_MAINNET=
NEXT_PUBLIC_RPC_URL_SEPOLIA=
