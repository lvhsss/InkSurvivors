# Copy to contracts/.env and fill in. Never commit .env — it's gitignored.

# Local deployer signing key (mainnet/sepolia/etc). Required for forge script
# --broadcast unless you self-broadcast from your own wallet via Remix/cast.
PRIVATE_KEY=

# RPC endpoints (paid keys recommended — public endpoints can fail mid-broadcast).
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
INK_SEPOLIA_RPC_URL=https://ink-sepolia.g.alchemy.com/v2/alch_Y8AIA4rANATC1g4eq5HWg

# Etherscan verification — grab a free key at https://etherscan.io/myapikey.
ETHERSCAN_API_KEY=
# Basescan verification (only if also deploying to Base) — https://basescan.org/myapikey.
BASESCAN_API_KEY=
