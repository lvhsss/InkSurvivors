// src/InkMath.sol

/// @title InkMath
/// @notice Pure library deriving an InkSurvivors token's current state from
///         `(tokenId, inkSeeds)` per the MIN-7/MIN-8 mechanics.
/// @dev    No storage writes. Compute is O(inksLivedThrough) per call.
///
///         ## State model
///         - `Alive`   — pre-mutation Base Human (`traitCount == 0`) and all
///                       trait-bearing survivors share this status. A token
///                       is considered "Base Human" iff
///                       `status == Alive && traitCount == 0`.
///         - `Tombstone` — dead. No traits. Background forced gray by Renderer.
///         - `Zombie`  — resurrected from Tombstone via a single one-time roll
///                       at the resurrection ink. Traits frozen forever.
///                       Skin is forbidden for zombies.
///
///         ## Per-ink transition (Alive)
///         - `P_DEATH`            = 50%  → Tombstone (all traits cleared)
///         - `pGainByCount(N)`    → +1 trait drawn from non-filled groups by
///                                  weight (`W_*`). Diminishing returns:
///                                  pGain decreases monotonically as the
///                                  current trait count grows.
///         - residual             → Survive Unchanged.
///
///         ## Per-ink transition (Tombstone)
///         - `P_RESURRECT`        = 3%   → Zombie. Zombie traits are rolled
///                                          once via independent per-group
///                                          Bernoulli rolls (`P_ZOMBIE_DROP`
///                                          per non-Skin group). Skin is
///                                          permanently excluded.
///         - residual             → Stay Tombstone.
///
///         ## Skin rarest invariant
///         `W_SKIN` is strictly less than every other group weight, so when
///         all groups are eligible the conditional probability of dropping a
///         Skin trait is strictly lower than any other group. Skin is still
///         mathematically reachable (`W_SKIN > 0`).
library InkMath {
    enum Status {
        Alive,
        Tombstone,
        Zombie,
        // MIN-38: deterministic 1/1 grail. Token is permanently exempt from
        // mutation; Renderer paints a single full-frame primitive.
        OneOfOne
    }

    /// @dev Trait slots are uint8: 0 = unfilled, 1..N = local trait id.
    ///      `oneOfOneId` is 0 unless `status == OneOfOne`, in which case it
    ///      carries the 1..ONE_OF_ONE_COUNT slot the token won.
    struct TokenState {
        Status status;
        uint8 background;
        uint8 head;
        uint8 hand;
        uint8 mouth;
        uint8 skin;
        uint8 underwear;
        uint8 traitCount;
        uint8 oneOfOneId;
    }

    uint256 internal constant INK_SIZE = 1000;

    // ---------------------------------------------------------------------
    // MIN-38 — 1/1 grail mechanic
    //
    // Divide the 10k supply into ONE_OF_ONE_COUNT equally-sized buckets.
    // Each bucket has exactly one winner, deterministically resolved from the
    // bucket's ink seed:
    //
    //   winner(bucket) = (keccak256(abi.encode(inkSeeds[bucket])) % BUCKET_SIZE)
    //                  + 1 + bucket * BUCKET_SIZE
    //
    // BUCKET_SIZE * ONE_OF_ONE_COUNT must equal the contract's MAX_SUPPLY
    // (10_000) so every supply slot belongs to exactly one bucket.
    //
    // Properties:
    //   - Pre-mint unpredictable: depends on `block.prevrandao` at the moment
    //     the bucket's ink closed (1000-mint boundary).
    //   - Post-mint provably-fair: the seed is on-chain and immutable.
    //   - Each 1/1 lands iff its bucket is fully minted (guaranteed at
    //     MAX_SUPPLY).
    //   - Hash preimage is a single uint256 (32 bytes), distinct from the
    //     mutation-roll preimage `(seed, tokenId)` (64 bytes), so the bucket
    //     winner check cannot collide with any trait roll.
    // ---------------------------------------------------------------------
    uint256 internal constant BUCKET_SIZE = 2500;
    uint8 internal constant ONE_OF_ONE_COUNT = 4;

    // ---------------------------------------------------------------------
    // Group sizes
    //
    // Background uses a 6-id palette where 2 ids are state-reserved:
    //   1 = Tombstone (#282828) — only ever rendered on Tombstone tokens
    //   4 = Zombie    (#33357C) — only ever rendered on Zombie tokens
    // Live tokens roll from the 4-id live-gainable subset {2, 3, 5, 6}
    // (see `Assets.backgroundLiveAt`). The bg ID for a tombstone or zombie
    // is forced by the Renderer regardless of `state.background`, so we
    // never roll a bg trait at resurrection (see `_resurrectAsZombie`).
    // ---------------------------------------------------------------------
    // Trait IDs are LOCKED against `assets/Assets.sol` function order:
    //   background: 1=Tombstone(reserved), 2=Blue, 3=Orange,
    //               4=Zombie(reserved), 5=Purple, 6=Red
    //   head:       1=UFO, 2=clown, 3=crown, 4=halo, 5=hood, 6=wiz_hat
    //   hand:       1=banana, 2=gun, 3=harp, 4=sword, 5=torch, 6=wand
    //   mouth:      1=cigar, 2=glasses, 3=spit
    //   skin:       1=alien, 2=ape, 3=zombie (live overlay; skinBase/skinTombstone are state)
    //   underwear:  1=underwear-1, 2=underwear-2
    uint8 internal constant BACKGROUND_COUNT = 6;
    uint8 internal constant HEAD_COUNT = 6;
    uint8 internal constant HAND_COUNT = 6;
    uint8 internal constant MOUTH_COUNT = 3;
    // MIN-33: rollable skins for Alive tokens are Alien (1) and Ape (2). Id 3
    // (Zombie skin) is reserved for the Zombie state and forced by the Renderer.
    uint8 internal constant SKIN_COUNT = 2;
    uint8 internal constant UNDERWEAR_COUNT = 2;

    // ---------------------------------------------------------------------
    // Trait-drop group weights (MIN-33 amended). Skin is the rare grail.
    // Background is set at mint (random in Renderer) but is not re-rolled
    // by ink mutation, so W_BG = 0. Listed weights sum to 100.
    // ---------------------------------------------------------------------
    uint256 internal constant W_BG = 0;
    uint256 internal constant W_HEAD = 25;
    uint256 internal constant W_HAND = 25;
    uint256 internal constant W_MOUTH = 10;
    uint256 internal constant W_UNDERWEAR = 35;
    uint256 internal constant W_SKIN = 5;

    // ---------------------------------------------------------------------
    // Outcome probabilities (out of 100).
    // ---------------------------------------------------------------------
    uint256 internal constant ROLL_DENOM = 100;
    uint256 internal constant P_DEATH = 30;
    uint256 internal constant P_RESURRECT = 5;
    uint256 internal constant P_ZOMBIE_DROP = 50; // legacy — unused after exponential zombie rewrite

    /// @notice Diminishing-returns curve for the trait-gain probability.
    /// @dev    Monotonic non-increasing in `n`. Sum with `P_DEATH` is always
    ///         ≤ 100 so a residual "survive unchanged" branch is well-defined.
    ///         Per MIN-33: 45 / 30 / 15 / 5 / 1 / 0 for n = 0..5.
    function pGainByCount(uint8 n) internal pure returns (uint256) {
        if (n == 0) return 45;
        if (n == 1) return 30;
        if (n == 2) return 15;
        if (n == 3) return 5;
        if (n == 4) return 1;
        return 0;
    }

    /// @notice Apply one ink's mutation to `state`.
    /// @dev    Memory struct passed by reference — mutated in place.
    function step(TokenState memory state, uint256 seed, uint256 tokenId) internal pure {
        if (state.status == Status.Zombie || state.status == Status.OneOfOne) {
            return; // zombies and 1/1s are terminal
        }

        uint256 h = uint256(keccak256(abi.encode(seed, tokenId)));
        uint256 roll = h % ROLL_DENOM;

        if (state.status == Status.Tombstone) {
            if (roll < P_RESURRECT) {
                _resurrectAsZombie(state, h);
            }
            return;
        }

        // Alive (incl. Base Human at traitCount == 0).
        if (roll < P_DEATH) {
            _toTombstone(state);
            return;
        }
        uint256 pGain = pGainByCount(state.traitCount);
        if (roll < P_DEATH + pGain) {
            _addTrait(state, h);
        }
        // else: survive unchanged.
    }

    /// @notice Compute the current state for `tokenId` given the full `inkSeeds` array.
    /// @dev    MIN-38: if the token is a 1/1 winner the state short-circuits to
    ///         `OneOfOne`, skipping all mutation rolls.
    function compute(uint256 tokenId, uint256[] memory inkSeeds)
        internal
        pure
        returns (TokenState memory state)
    {
        uint8 ooo = oneOfOneWinner(tokenId, inkSeeds);
        if (ooo != 0) {
            state.status = Status.OneOfOne;
            state.oneOfOneId = ooo;
            return state;
        }

        uint256 firstIdx = (tokenId - 1) / INK_SIZE;
        uint256 len = inkSeeds.length;
        for (uint256 i = firstIdx; i < len; i++) {
            step(state, inkSeeds[i], tokenId);
        }
    }

    /// @notice Returns the 1/1 slot (1..ONE_OF_ONE_COUNT) that `tokenId` won,
    ///         or 0 if the token is not a winner.
    /// @dev    A token's bucket is `(tokenId - 1) / BUCKET_SIZE`. The winner is
    ///         not resolved until the bucket's ink seed is pushed (i.e. the
    ///         first 1000-mint boundary inside the bucket has been crossed).
    ///         Once resolved the answer is permanent for that `inkSeeds`.
    function oneOfOneWinner(uint256 tokenId, uint256[] memory inkSeeds) internal pure returns (uint8) {
        if (tokenId == 0) return 0;
        uint256 bucket = (tokenId - 1) / BUCKET_SIZE;
        if (bucket >= ONE_OF_ONE_COUNT) return 0;
        if (inkSeeds.length <= bucket) return 0;
        uint256 winner =
            (uint256(keccak256(abi.encode(inkSeeds[bucket]))) % BUCKET_SIZE) + 1 + bucket * BUCKET_SIZE;
        return winner == tokenId ? uint8(bucket + 1) : 0;
    }

    /// @notice Index of the first ink seed that ever applies to `tokenId`.
    function firstSeedIndex(uint256 tokenId) internal pure returns (uint256) {
        return (tokenId - 1) / INK_SIZE;
    }

    /// @notice True when the token is in the visual Base Human state.
    function isBaseHuman(TokenState memory state) internal pure returns (bool) {
        return state.status == Status.Alive && state.traitCount == 0;
    }

    // ---------------------------------------------------------------------
    // Internal helpers
    // ---------------------------------------------------------------------

    function _toTombstone(TokenState memory state) private pure {
        state.status = Status.Tombstone;
        state.background = 0;
        state.head = 0;
        state.hand = 0;
        state.mouth = 0;
        state.skin = 0;
        state.underwear = 0;
        state.traitCount = 0;
    }

    /// @dev Drops a single trait into the first non-filled group selected by
    ///      weight. Empty groups (count == 0) and already-filled groups are
    ///      assigned weight 0 so they cannot be chosen.
    function _addTrait(TokenState memory state, uint256 h) private pure {
        uint256 wBg = (BACKGROUND_COUNT > 0 && state.background == 0) ? W_BG : 0;
        uint256 wHead = (HEAD_COUNT > 0 && state.head == 0) ? W_HEAD : 0;
        uint256 wHand = (HAND_COUNT > 0 && state.hand == 0) ? W_HAND : 0;
        uint256 wMouth = (MOUTH_COUNT > 0 && state.mouth == 0) ? W_MOUTH : 0;
        uint256 wUnder = (UNDERWEAR_COUNT > 0 && state.underwear == 0) ? W_UNDERWEAR : 0;
        uint256 wSkin = (SKIN_COUNT > 0 && state.skin == 0) ? W_SKIN : 0;
        uint256 total = wBg + wHead + wHand + wMouth + wUnder + wSkin;
        if (total == 0) return;

        uint256 pick = (h >> 8) % total;
        uint256 traitRoll = h >> 16;

        uint256 cum = wBg;
        if (pick < cum) {
            // Live tokens may only roll a live-gainable background id; reserved
            // ids 1 (Tombstone) and 4 (Zombie) are filtered out by Assets.
            uint8 liveCount = Assets.backgroundLiveCount();
            state.background = Assets.backgroundLiveAt(uint8(traitRoll % liveCount));
            state.traitCount++;
            return;
        }
        cum += wHead;
        if (pick < cum) {
            state.head = uint8((traitRoll % HEAD_COUNT) + 1);
            state.traitCount++;
            return;
        }
        cum += wHand;
        if (pick < cum) {
            state.hand = uint8((traitRoll % HAND_COUNT) + 1);
            state.traitCount++;
            return;
        }
        cum += wMouth;
        if (pick < cum) {
            state.mouth = uint8((traitRoll % MOUTH_COUNT) + 1);
            state.traitCount++;
            return;
        }
        cum += wUnder;
        if (pick < cum) {
            state.underwear = uint8((traitRoll % UNDERWEAR_COUNT) + 1);
            state.traitCount++;
            return;
        }
        // Residual: skin.
        state.skin = uint8((traitRoll % SKIN_COUNT) + 1);
        state.traitCount++;
    }

    /// @dev One-time Zombie roll. Trait count is sampled from an exponentially
    ///      decaying distribution — getting 1 trait is common, getting all 4
    ///      non-Skin groups is extremely rare. Skin is permanently excluded
    ///      per rule 6; Background is excluded because the Renderer forces the
    ///      Zombie-reserved bg id for every Zombie. Weights (out of 31):
    ///        N=0 → 1   (3.2%)
    ///        N=1 → 16  (51.6%)
    ///        N=2 → 8   (25.8%)
    ///        N=3 → 4   (12.9%)
    ///        N=4 → 2   (6.5%)
    function _resurrectAsZombie(TokenState memory state, uint256 h) private pure {
        state.status = Status.Zombie;
        uint256 g = uint256(keccak256(abi.encode(h, "zombie")));

        uint256 roll = g % 31;
        uint8 targetCount;
        if (roll < 1) targetCount = 0;
        else if (roll < 17) targetCount = 1;
        else if (roll < 25) targetCount = 2;
        else if (roll < 29) targetCount = 3;
        else targetCount = 4;

        // Shuffle a [Head, Hand, Mouth, Underwear] permutation, then fill the
        // first `targetCount` groups. Fixed 4-element Fisher–Yates — bounded
        // loops at this scale are gas-trivial and run only at view time.
        uint8[4] memory groupOrder = [uint8(0), 1, 2, 3];
        for (uint256 i = 3; i > 0; i--) {
            uint256 j = (g >> (16 + (i * 8))) % (i + 1);
            (groupOrder[i], groupOrder[j]) = (groupOrder[j], groupOrder[i]);
        }

        for (uint8 idx = 0; idx < targetCount; idx++) {
            uint8 gid = groupOrder[idx];
            uint256 traitRoll = g >> (64 + (uint256(gid) * 16));
            if (gid == 0 && HEAD_COUNT > 0) state.head = uint8((traitRoll % HEAD_COUNT) + 1);
            else if (gid == 1 && HAND_COUNT > 0) state.hand = uint8((traitRoll % HAND_COUNT) + 1);
            else if (gid == 2 && MOUTH_COUNT > 0) state.mouth = uint8((traitRoll % MOUTH_COUNT) + 1);
            else if (gid == 3 && UNDERWEAR_COUNT > 0) state.underwear = uint8((traitRoll % UNDERWEAR_COUNT) + 1);
        }
        // Skin forbidden by rule 6 — never set on zombies.
        state.traitCount = targetCount;
    }
}

// src/Renderer.sol

/// @title Renderer
/// @notice Composes on-chain SVG and packages it as a
///         `data:application/json;base64,...` URI for InkSurvivors.
///
///         ## Layer order
///         background → base/skin → underwear → hand → mouth → head
///
///         ## Tombstone invariant
///         Tombstone renders only a plain gray background plus the tombstone
///         shape primitive. No trait layers are emitted and no per-token
///         attributes are advertised. This is asserted by
///         `Renderer.t.sol::test_render_tombstone_isGrayAndTraitless`.
///
///         ## Zombie invariant
///         Zombie uses the dedicated zombie skin primitive and renders any
///         non-Skin traits captured at resurrection. Skin slot is by spec
///         always 0 on Zombies.
///
///         ## OneOfOne invariant (MIN-38)
///         A 1/1 winner renders ONLY its full-frame primitive — no base, no
///         skin, no overlays. Attributes carry exactly two fields: `Status =
///         "1 of 1"` and `1/1 = <Name>`. No Background / Trait Count / etc.
///
///         ## Asset coverage
///         The current `assets/Assets.sol` ships only the subset of
///         primitives wired below; trait IDs without an artwork yet render
///         as empty layers. PixelArt (MIN-5) will add the remaining
///         primitives and a follow-up commit will plug them in.
library Renderer {
    using Strings for uint256;

    string internal constant SVG_OPEN = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" '
        'shape-rendering="crispEdges" width="512" height="512">';
    string internal constant SVG_CLOSE = "</svg>";

    /// @dev Fallback background used when an Alive token has no Background trait.
    string internal constant BG_DEFAULT = '<rect width="32" height="32" fill="#1a1a2e"/>';

    function tokenURI(uint256 tokenId, InkMath.TokenState memory state) internal pure returns (string memory) {
        // Per spec (MIN-33 amended): a freshly-minted token is a "Default Naked Human"
        // with 0 traits and a random background. Other slots stay empty until an
        // ink boundary mutation rolls them.
        if (state.status == InkMath.Status.Alive && state.background == 0) {
            uint8 liveCount = Assets.backgroundLiveCount();
            if (liveCount > 0) {
                uint256 h = uint256(keccak256(abi.encode("MIN-33-starter-bg", tokenId)));
                state.background = Assets.backgroundLiveAt(uint8(h % liveCount));
            }
        }

        string memory svgBody = _svg(state);
        string memory imageURI =
            string(abi.encodePacked("data:image/svg+xml;base64,", Base64.encode(bytes(svgBody))));

        bytes memory json = abi.encodePacked(
            '{"name":"Ink Survivors #',
            tokenId.toString(),
            '","description":"On-chain ink survivor. State is derived live from inkSeeds.",',
            '"image":"',
            imageURI,
            '","attributes":',
            _attributes(state),
            "}"
        );

        return string(abi.encodePacked("data:application/json;base64,", Base64.encode(json)));
    }

    function svg(InkMath.TokenState memory state) internal pure returns (string memory) {
        return _svg(state);
    }

    function _svg(InkMath.TokenState memory state) private pure returns (string memory) {
        if (state.status == InkMath.Status.OneOfOne) {
            // 1/1 grail: render the full-frame primitive only. No base layer,
            // no skin, no overlays — per MIN-38 spec.
            return string(abi.encodePacked(SVG_OPEN, _oneOfOne(state.oneOfOneId), SVG_CLOSE));
        }

        if (state.status == InkMath.Status.Tombstone) {
            return string(
                abi.encodePacked(
                    SVG_OPEN,
                    Assets.backgroundById(Assets.backgroundTombstoneId()),
                    Assets.skinTombstone(),
                    SVG_CLOSE
                )
            );
        }

        if (state.status == InkMath.Status.Zombie) {
            // Zombie background is render-forced regardless of state.background;
            // InkMath never assigns a bg trait at resurrection.
            return string(
                abi.encodePacked(
                    SVG_OPEN,
                    Assets.backgroundById(Assets.backgroundZombieId()),
                    Assets.skinZombie(),
                    _underwear(state.underwear),
                    _hand(state.hand),
                    _mouth(state.mouth),
                    _head(state.head),
                    SVG_CLOSE
                )
            );
        }

        // Alive (incl. Base Human at traitCount == 0). Strict layer order:
        //   background → base → skin (overlay) → underwear → hand → mouth → head.
        // Base is ALWAYS emitted so a skin trait paints on top of base pixels
        // rather than replacing them — see MIN-14 scope #2.
        return string(
            abi.encodePacked(
                SVG_OPEN,
                _background(state.background),
                Assets.skinBase(),
                _skin(state.skin),
                _underwear(state.underwear),
                _hand(state.hand),
                _mouth(state.mouth),
                _head(state.head),
                SVG_CLOSE
            )
        );
    }

    // ---------------------------------------------------------------------
    // Asset id → primitive
    //
    // IDs are 1-indexed and follow the alphabetical-by-filename ordering of
    // `assets/source/<group>/*.svg`. Slots without art yet render to "".
    // ---------------------------------------------------------------------

    function _background(uint8 id) private pure returns (string memory) {
        if (id == 0) return BG_DEFAULT; // Alive Base Human with no bg trait yet
        return Assets.backgroundById(id);
    }

    function _skin(uint8 id) private pure returns (string memory) {
        if (id == 1) return Assets.skinAlien();
        if (id == 2) return Assets.skinApe();
        if (id == 3) return Assets.skinZombie();
        return "";
    }

    function _hand(uint8 id) private pure returns (string memory) {
        if (id == 1) return Assets.handBanana();
        if (id == 2) return Assets.handGun();
        if (id == 3) return Assets.handHarp();
        if (id == 4) return Assets.handSword();
        if (id == 5) return Assets.handTorch();
        if (id == 6) return Assets.handWand();
        return "";
    }

    function _head(uint8 id) private pure returns (string memory) {
        if (id == 1) return Assets.headUFO();
        if (id == 2) return Assets.headClown();
        if (id == 3) return Assets.headCrown();
        if (id == 4) return Assets.headHalo();
        if (id == 5) return Assets.headHood();
        if (id == 6) return Assets.headWizHat();
        return "";
    }

    function _mouth(uint8 id) private pure returns (string memory) {
        if (id == 1) return Assets.mouthCigar();
        if (id == 2) return Assets.mouthGlasses();
        if (id == 3) return Assets.mouthSpit();
        return "";
    }

    function _underwear(uint8 id) private pure returns (string memory) {
        if (id == 1) return Assets.underwearUnderwear1();
        if (id == 2) return Assets.underwearUnderwear2();
        return "";
    }

    /// @dev MIN-38: id ordering follows the alphabetical filename order of
    ///      `assets/source/1of1/*.svg` exposed by AssetsOneOfOne — id 1 is
    ///      austronaut (rendered as "Astronaut"), 2 dracula, 3 master, 4 superman.
    function _oneOfOne(uint8 id) private pure returns (string memory) {
        if (id == 1) return Assets.oneOfOneAustronaut();
        if (id == 2) return Assets.oneOfOneDracula();
        if (id == 3) return Assets.oneOfOneMaster();
        if (id == 4) return Assets.oneOfOneSuperman();
        return "";
    }

    // ---------------------------------------------------------------------
    // Attribute names
    // ---------------------------------------------------------------------

    function _statusName(InkMath.TokenState memory state) private pure returns (string memory) {
        if (state.status == InkMath.Status.Tombstone) return "Tombstone";
        if (state.status == InkMath.Status.Zombie) return "Zombie";
        if (state.status == InkMath.Status.OneOfOne) return "1 of 1";
        if (state.traitCount == 0) return "Base Human";
        return "Alive";
    }

    function _oneOfOneName(uint8 id) private pure returns (string memory) {
        if (id == 1) return "Astronaut";
        if (id == 2) return "Dracula";
        if (id == 3) return "Master";
        if (id == 4) return "Superman";
        return "";
    }

    function _headName(uint8 id) private pure returns (string memory) {
        if (id == 1) return "UFO";
        if (id == 2) return "Clown";
        if (id == 3) return "Crown";
        if (id == 4) return "Halo";
        if (id == 5) return "Hood";
        if (id == 6) return "Wizard Hat";
        return "";
    }

    function _handName(uint8 id) private pure returns (string memory) {
        if (id == 1) return "Banana";
        if (id == 2) return "Gun";
        if (id == 3) return "Harp";
        if (id == 4) return "Sword";
        if (id == 5) return "Torch";
        if (id == 6) return "Wand";
        return "";
    }

    function _mouthName(uint8 id) private pure returns (string memory) {
        if (id == 1) return "Cigar";
        if (id == 2) return "Glasses";
        if (id == 3) return "Spit";
        return "";
    }

    function _skinName(uint8 id) private pure returns (string memory) {
        if (id == 1) return "Alien";
        if (id == 2) return "Ape";
        if (id == 3) return "Zombie";
        return "";
    }

    function _underwearName(uint8 id) private pure returns (string memory) {
        if (id == 1) return "Underwear 1";
        if (id == 2) return "Underwear 2";
        return "";
    }

    function _backgroundName(uint8 id) private pure returns (string memory) {
        if (id == 1) return "Tombstone"; // reserved, only seen on Tombstone tokens
        if (id == 2) return "Blue";
        if (id == 3) return "Orange";
        if (id == 4) return "Zombie"; // reserved, only seen on Zombie tokens
        if (id == 5) return "Purple";
        if (id == 6) return "Red";
        return "";
    }

    function _attributes(InkMath.TokenState memory state) private pure returns (string memory) {
        // OneOfOne: exactly two attributes — Status and the 1/1 name. No
        // Background, no Trait Count, no overlays. MIN-38.
        if (state.status == InkMath.Status.OneOfOne) {
            return string(
                abi.encodePacked(
                    '[{"trait_type":"Status","value":"1 of 1"},',
                    '{"trait_type":"1/1","value":"',
                    _oneOfOneName(state.oneOfOneId),
                    '"}]'
                )
            );
        }

        bytes memory out =
            abi.encodePacked('[{"trait_type":"Status","value":"', _statusName(state), '"}');

        // Tombstones: status only. Per spec, no trait attributes.
        if (state.status == InkMath.Status.Tombstone) {
            return string(abi.encodePacked(out, "]"));
        }

        if (state.background != 0) {
            out = abi.encodePacked(
                out, ',{"trait_type":"Background","value":"', _backgroundName(state.background), '"}'
            );
        }
        if (state.head != 0) {
            out = abi.encodePacked(out, ',{"trait_type":"Head","value":"', _headName(state.head), '"}');
        }
        if (state.hand != 0) {
            out = abi.encodePacked(out, ',{"trait_type":"Hand","value":"', _handName(state.hand), '"}');
        }
        if (state.mouth != 0) {
            out = abi.encodePacked(out, ',{"trait_type":"Mouth","value":"', _mouthName(state.mouth), '"}');
        }
        if (state.skin != 0) {
            out = abi.encodePacked(out, ',{"trait_type":"Skin","value":"', _skinName(state.skin), '"}');
        }
        if (state.underwear != 0) {
            out = abi.encodePacked(
                out, ',{"trait_type":"Underwear","value":"', _underwearName(state.underwear), '"}'
            );
        }
        out = abi.encodePacked(
            out, ',{"trait_type":"Trait Count","value":', uint256(state.traitCount).toString(), "}"
        );

        return string(abi.encodePacked(out, "]"));
    }
}

// src/InkSurvivors.sol

/// @title InkSurvivors
/// @notice ERC721A NFT with on-chain pixel art and ink-based mutation gambling.
contract InkSurvivors is ERC721A {
    uint256 public constant MAX_SUPPLY = 10_000;
    /// @notice Mint price per token (0.0001 ETH per MIN-33).
    uint256 public constant MINT_PRICE = 0.0001 ether;
    /// @notice Hard cap on quantity per mint() call.
    uint256 public constant MAX_PER_TX = 5;
    /// @notice Hard cap on total tokens any single wallet may hold from mints.
    uint256 public constant MAX_PER_WALLET = 20;
    uint256 public constant INK_SIZE = 1_000;

    /// @notice EIP-2981 royalty fee — 3% of secondary-sale price.
    uint96 public constant ROYALTY_FEE_BPS = 300;
    uint96 internal constant BPS_DENOM = 10_000;

    /// @notice Mint fees always withdraw to this hard-coded wallet.
    address public constant FEES_WALLET = 0x6C26bDE1e1E71821Af36760f8c55997d38961EB2;

    address public immutable owner;
    uint256[] public inkSeeds;
    mapping(address => uint256) public mintedPerWallet;

    event InkClosed(uint256 indexed inkIndex, uint256 seed, uint256 mintedAt);

    error QuantityInvalid();
    error QuantityExceedsTxLimit();
    error WalletMintLimit();
    error WrongMintPrice();
    error SupplyExhausted();
    error WithdrawFailed();

    constructor() ERC721A("Ink Survivors", "INK") {
        owner = msg.sender;
    }

    function _startTokenId() internal pure override returns (uint256) {
        return 1;
    }

    /// @notice Mint `quantity` InkSurvivors tokens. Caps:
    ///         - `quantity > 0 && quantity <= MAX_PER_TX`
    ///         - sender's lifetime mint count must stay `<= MAX_PER_WALLET`
    ///         - `msg.value == MINT_PRICE * quantity`
    function mint(uint256 quantity) external payable {
        if (quantity == 0) revert QuantityInvalid();
        if (quantity > MAX_PER_TX) revert QuantityExceedsTxLimit();
        if (msg.value != MINT_PRICE * quantity) revert WrongMintPrice();

        uint256 newWalletCount = mintedPerWallet[msg.sender] + quantity;
        if (newWalletCount > MAX_PER_WALLET) revert WalletMintLimit();

        uint256 oldTotal = _totalMinted();
        uint256 newTotal = oldTotal + quantity;
        if (newTotal > MAX_SUPPLY) revert SupplyExhausted();

        mintedPerWallet[msg.sender] = newWalletCount;
        _mint(msg.sender, quantity);

        // Push an ink seed for every INK_SIZE boundary crossed in (oldTotal, newTotal].
        uint256 firstBoundary = ((oldTotal / INK_SIZE) + 1) * INK_SIZE;
        for (uint256 boundary = firstBoundary; boundary <= newTotal; boundary += INK_SIZE) {
            uint256 seed = uint256(keccak256(abi.encode(block.prevrandao, boundary, blockhash(block.number - 1))));
            uint256 idx = inkSeeds.length;
            inkSeeds.push(seed);
            emit InkClosed(idx, seed, boundary);
        }
    }

    function inkSeedsLength() external view returns (uint256) {
        return inkSeeds.length;
    }

    function stateOf(uint256 tokenId) external view returns (InkMath.TokenState memory) {
        if (!_exists(tokenId)) revert URIQueryForNonexistentToken();
        return InkMath.compute(tokenId, inkSeeds);
    }

    function tokenURI(uint256 tokenId) public view virtual override returns (string memory) {
        if (!_exists(tokenId)) revert URIQueryForNonexistentToken();
        InkMath.TokenState memory state = InkMath.compute(tokenId, inkSeeds);
        return Renderer.tokenURI(tokenId, state);
    }

    /// @notice EIP-2981 royalty lookup. Marketplaces call this to discover the
    ///         royalty recipient + fee for a given sale price. We use a flat 3%
    ///         to `FEES_WALLET` regardless of `tokenId`.
    function royaltyInfo(uint256, /* tokenId */ uint256 salePrice)
        external
        pure
        returns (address receiver, uint256 royaltyAmount)
    {
        return (FEES_WALLET, (salePrice * ROYALTY_FEE_BPS) / BPS_DENOM);
    }

    /// @notice ERC-165 interface support. Advertises ERC721A and EIP-2981.
    ///         `0x2a55205a` is the EIP-2981 interface id.
    function supportsInterface(bytes4 interfaceId) public view virtual override returns (bool) {
        return interfaceId == 0x2a55205a || super.supportsInterface(interfaceId);
    }

    /// @notice Withdraw the accumulated mint fees. Anyone may call; funds always
    ///         go to `FEES_WALLET`.
    function withdraw() external {
        (bool ok,) = payable(FEES_WALLET).call{value: address(this).balance}("");
        if (!ok) revert WithdrawFailed();
    }
}

